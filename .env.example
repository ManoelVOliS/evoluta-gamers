# ---------------------------------------------------------------- geral ---
NODE_ENV=development
TZ=America/Sao_Paulo
WEB_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------ api ---
PORT=3333
MONGO_URI=mongodb://localhost:27017/evoluta-gamers

# Gera com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-isto-por-no-minimo-32-caracteres-aleatorios
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Chave ÚNICA da aplicação: https://steamcommunity.com/dev/apikey
# Não é chave "por usuário" — ver TASKS/ANALISE_PRD.md §2.
STEAM_API_KEY=

# Primeiro admin, criado só se a coleção `users` estiver vazia.
ADMIN_EMAIL=admin@evoluta.local
ADMIN_PASSWORD=

# ---------------------------------------------------------------- mongo ---
MONGO_INITDB_ROOT_USERNAME=evoluta
MONGO_INITDB_ROOT_PASSWORD=
