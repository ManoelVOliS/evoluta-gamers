# ---------------------------------------------------------------- geral ---
NODE_ENV=development
TZ=America/Sao_Paulo
# 5173 é do eVOLUTA Hub; o Gamers roda em 5273.
WEB_ORIGIN=http://localhost:5273

# ------------------------------------------------------------------ api ---
PORT=3333
# Instância própria do projeto (host via Tailscale). Credenciais reais vão em
# apps/api/.env, que é ignorado pelo git — nunca neste arquivo.
MONGO_URI=mongodb://USUARIO:SENHA@HOST:27017/evoluta-gamers?authSource=admin

# Gera com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-isto-por-no-minimo-32-caracteres-aleatorios
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Chave ÚNICA da aplicação: https://steamcommunity.com/dev/apikey
# Não é chave "por usuário" — ver TASKS/ANALISE_PRD.md §2.
STEAM_API_KEY=

# Epic Games via `legendary` (open source) — aqui SIM é segredo por usuário
# (sessão real de cada um), por isso precisa de criptografia reversível.
# Gera com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ver TASKS/capitulos/04-steam.md, adendo Epic Games.
EPIC_TOKEN_ENCRYPTION_KEY=
# Caminho do binário `legendary`. No Docker já vem setado pelo Dockerfile;
# em dev local só precisa se o `pip install legendary-gl` não colocar no PATH.
LEGENDARY_BIN=legendary

# Primeiro admin, criado só se a coleção `users` estiver vazia.
ADMIN_EMAIL=admin@evoluta.local
ADMIN_PASSWORD=

# ---------------------------------------------------------------- mongo ---
# Usado só pelo serviço `mongo` do docker-compose (opcional: o projeto pode
# apontar direto para a instância do homelab via MONGO_URI).
MONGO_INITDB_ROOT_USERNAME=evoluta
MONGO_INITDB_ROOT_PASSWORD=
