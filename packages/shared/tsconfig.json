{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // CommonJS de propósito: o NestJS (apps/api) roda em CJS, e o Vite (apps/web)
    // interopera com CJS sem reclamar. Emitir ESM aqui quebraria a API.
    "module": "node18",
    "moduleResolution": "node16",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src"]
}
