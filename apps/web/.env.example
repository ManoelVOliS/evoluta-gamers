# URL base da API NestJS. Em dev o Vite faz proxy de /api -> VITE_API_URL,
# então normalmente não precisa mexer.
VITE_API_URL=http://localhost:3333

# ID da extensão MV3 de vínculo Epic (Fase 2). Em dev: carregue
# apps/extension/dist como "não empacotada" em chrome://extensions e copie o
# ID mostrado lá. Vazio = a tela some com o botão de extensão e cai direto no
# fluxo manual (comportamento de hoje).
VITE_EPIC_EXTENSION_ID=
